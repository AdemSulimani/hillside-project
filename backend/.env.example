# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hillside
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Public base URL of this API (attachments, absolute links). Defaults to http://localhost:${PORT} if unset.
BACKEND_URL=http://localhost:8000

# --- Auth (required in production) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- AI ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EVAL_MODEL=meta-llama/llama-3.1-8b-instant
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
SIMILARITY_THRESHOLD=0.75
QUALITY_THRESHOLD=0.6

# Embeddings (defaults to Groq if EMBEDDING_API_KEY empty)
EMBEDDING_API_URL=https://api.groq.com/openai/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text-v1_5

# --- Data stores ---
REDIS_URL=redis://127.0.0.1:6379

# --- Meta / channels ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/oauth/meta/callback
WEBHOOK_VERIFY_TOKEN=
ENCRYPTION_KEY=

# --- Ops / optional ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ADMIN_KEY=
# Separate secret for platform-owner JWT (POST /api/admin/auth/login). Must differ from JWT_SECRET.
ADMIN_JWT_SECRET=
ALERT_WEBHOOK_URL=
QUEUE_HEALTH_DEPTH_WARNING=
FINETUNING_THRESHOLD=
FINETUNING_CRON=0 2 * * *
OUTBOUND_API_MAX_PER_HOUR=200
OUTBOUND_API_WINDOW_SEC=3600
