# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hillside
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Public base URL of this API (attachments, absolute links). Defaults to http://localhost:${PORT} if unset.
BACKEND_URL=http://localhost:8000

# --- Auth (required in production) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- AI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EVAL_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
SIMILARITY_THRESHOLD=0.75
QUALITY_THRESHOLD=0.6

# Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Data stores ---
REDIS_URL=redis://127.0.0.1:6379

# --- Meta / channels ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/oauth/meta/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/oauth/instagram/callback
WEBHOOK_VERIFY_TOKEN=
ENCRYPTION_KEY=

# --- Ops / optional ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ADMIN_KEY=
# Separate secret for platform-owner JWT (POST /api/admin/auth/login). Must differ from JWT_SECRET.
ADMIN_JWT_SECRET=
ALERT_WEBHOOK_URL=
QUEUE_HEALTH_DEPTH_WARNING=
FINETUNING_THRESHOLD=
FINETUNING_CRON=0 2 * * *
OPENAI_FINETUNING_BASE_MODEL=gpt-4o-mini-2024-07-18
OUTBOUND_API_MAX_PER_HOUR=200
OUTBOUND_API_WINDOW_SEC=3600
