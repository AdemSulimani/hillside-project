# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hillside
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Public base URL of this API (attachments, absolute links). Defaults to http://localhost:${PORT} if unset.
BACKEND_URL=http://localhost:8000

# --- Auth (required in production) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- AI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EVAL_MODEL=gpt-4o
OPENAI_INTENT_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
# Minimum cosine similarity (0–1) for a product to pass the semantic retrieval filter.
# Code default is 0.65 (better recall/precision balance for dense catalogs). Set to 0.75
# for tight, small catalogs where precision matters more than recall.
SIMILARITY_THRESHOLD=0.65
QUALITY_THRESHOLD=0.6

# Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Data stores ---
REDIS_URL=redis://127.0.0.1:6379

# --- Meta / channels ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://hypermetropic-ai-afflated.ngrok-free.dev/api/oauth/meta/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://hypermetropic-ai-afflated.ngrok-free.dev/api/oauth/instagram/callback
WEBHOOK_VERIFY_TOKEN=
# Optional legacy: was used to validate SPA redirect_uri for token exchange. Exchange no longer sends redirect_uri to Meta (FB.login code flow).
# You should still add your Channels page URL under Meta → Facebook Login for Business → Valid OAuth redirect URIs.
# WHATSAPP_EMBEDDED_SIGNUP_REDIRECT_URI=
# Partner Business Portfolio ID (Meta Business Manager). Used as fallback when resolving WABA from the embedded-signup token.
WHATSAPP_BUSINESS_ID=
# Embedded Signup configuration ID (used by the frontend Meta config).
WHATSAPP_CONFIGURATION_ID=
# Optional Graph API base for Business Management + WABA calls. Default: https://graph.facebook.com/v25.0
WHATSAPP_BUSINESS_MANAGEMENT_API=
# Optional legacy: not used by Embedded Signup token flow after code exchange (business token comes from oauth/access_token only).
# WHATSAPP_SYSTEM_USER_ID=
# Instagram/Facebook share normalization: max caption chars in stored message & AI context (0 = omit caption). Default 400.
INSTAGRAM_SHARE_CAPTION_MAX_CHARS=400
# Set to 1/true to log webhook signature failures and Instagram payload digests (no tokens).
WEBHOOK_DEBUG=
ENCRYPTION_KEY=

# --- Ops / optional ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ADMIN_KEY=
# Separate secret for platform-owner JWT (POST /api/admin/auth/login). Must differ from JWT_SECRET.
ADMIN_JWT_SECRET=
ALERT_WEBHOOK_URL=
QUEUE_HEALTH_DEPTH_WARNING=
FINETUNING_THRESHOLD=
FINETUNING_CRON=0 2 * * *
OPENAI_FINETUNING_BASE_MODEL=gpt-4o-mini-2024-07-18
OUTBOUND_API_MAX_PER_HOUR=200
OUTBOUND_API_WINDOW_SEC=3600

# --- Operational ---
# Graceful shutdown: how long to wait for in-flight BullMQ jobs to finish before
# forcing exit on SIGTERM/SIGINT. Should be > the longest expected AI reply time.
# Default: 25000 (25 s).
# SHUTDOWN_TIMEOUT_MS=25000

# Per-tenant AI reply concurrency cap. Jobs beyond this limit are re-delayed
# rather than starving other tenants. Default: 8.
# AI_MAX_CONCURRENT_PER_TENANT=8

# Redis memory monitoring thresholds (% of maxmemory). Fires ALERT_WEBHOOK_URL.
# Default: warn at 80%, critical at 90%.
# REDIS_MEMORY_WARNING_PCT=80
# REDIS_MEMORY_CRITICAL_PCT=90
# REDIS_MEMORY_CHECK_INTERVAL_MS=60000

# --- Retrieval tuning ---
# HNSW ef_search candidate pool size. The HNSW index is global (not per-tenant), so
# the post-filter by tenant_id consumes candidates. Raise this if semantic search
# returns too few results for small-catalog tenants in multi-tenant deployments.
# Must be >= FOCUSED_PRODUCT_MATCH_LIMIT. Default: 100.
# HNSW_EF_SEARCH=100

# Timeout (ms) for the per-message OpenAI query-embedding call. If exceeded, the
# semantic retrieval path is skipped and keyword/phrase search still runs (fail-open).
# Default: 5000.
# EMBEDDING_QUERY_TIMEOUT_MS=5000

# Embedding reconciliation scheduler: cron and max products re-queued per run.
# EMBEDDING_RECONCILE_CRON=0 */6 * * *
# EMBEDDING_RECONCILE_BATCH_LIMIT=200

# --- Product image matching (customer photo → catalog) ---
# Minimum cosine similarity for visual fingerprint retrieval (0–1). Default: 0.62
# IMAGE_SIMILARITY_THRESHOLD=0.62
# Minimum composite confidence before claiming an exact product match. Default: 0.55
# IMAGE_MATCH_CONFIDENCE_THRESHOLD=0.55
# Below this vision extraction confidence, ask the customer to clarify. Default: 0.35
# VISION_EXTRACTION_CONFIDENCE_MIN=0.35
# When top-2 visual matches are within this delta, run vision re-ranking. Default: 0.04
# IMAGE_MATCH_AMBIGUITY_DELTA=0.04
# Image fingerprint reconciliation (missing catalog image embeddings).
# IMAGE_FINGERPRINT_RECONCILE_CRON=30 */6 * * *
# IMAGE_FINGERPRINT_RECONCILE_BATCH_LIMIT=100
