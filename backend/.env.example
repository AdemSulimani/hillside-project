# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hillside
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Public base URL of this API (attachments, absolute links). Defaults to http://localhost:${PORT} if unset.
BACKEND_URL=http://localhost:8000

# --- Migrations (P3-3 runner; all optional, operational knobs — not in the config manifest) ---
# The runner applies pending migrations in ONE batch transaction (all-or-nothing). These tune it:
# MIGRATE_STRICT=1        — fail fast on duplicate/out-of-order ordinals, unannotated
#                           transaction-hostile SQL, or checksum drift. Set in CI + pre-deploy;
#                           a plain container boot only WARNS so a mis-set migration can't brick it.
# MIGRATE_PER_FILE=1      — one transaction per file (the pre-P3-3 behaviour). Escape hatch if the
#                           batch's longer lock-hold is a problem for a specific deploy.
# MIGRATE_LOCK_TIMEOUT_MS — SET LOCAL lock_timeout per batch txn (default 5000; 0 = off). A batch
#                           that can't get a lock fails fast instead of stalling the live app.
# MIGRATE_STATEMENT_TIMEOUT_MS — SET LOCAL statement_timeout per batch txn (default 0 = off).
# MIGRATE_ALLOW_DOWN=1    — REQUIRED to run `npm run migrate:down`. Prod rollback is re-deploy the
#                           previous tag, not a down migration; leave this unset in production.
# MIGRATE_STRICT=1
# MIGRATE_LOCK_TIMEOUT_MS=5000

# --- Auth (required in production) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- AI ---
OPENAI_API_KEY=
# Per-ROLE model config (P2-7). Every chat-family role falls back to OPENAI_CHAT_MODEL, so setting
# only OPENAI_CHAT_MODEL keeps today's behaviour exactly. Resolution order and defaults live in
# ONE place — backend/src/config/models.ts — and `npm run config:check` fails if this file drifts
# from it.
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EVAL_MODEL=gpt-4o
OPENAI_INTENT_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
# The boolean/structured classifier fan-out (~25 call sites: availability, affirmation, language,
# health-advice, name-hallucination, gap/attribute assessors...). These are small, temperature-0,
# 16–350-max_token calls that ride the same expensive model as the customer-facing reply unless you
# split them here. Unset => OPENAI_CHAT_MODEL. Changing this changes ~25 decision sites at once —
# validate against an eval corpus before pointing it at a cheaper model.
# OPENAI_CLASSIFIER_MODEL=gpt-4o
# Product extraction from uploaded documents/images. Unset => OPENAI_CHAT_MODEL, and if THAT is
# also unset => gpt-4o-mini (the long-standing behaviour of this path specifically).
# OPENAI_PRODUCT_PROCESSING_MODEL=gpt-4o-mini
# Retries/timeout applied to EVERY OpenAI call (defaults 3 / 60000ms).
# OPENAI_MAX_RETRIES=3
# OPENAI_TIMEOUT_MS=60000
# Minimum cosine similarity (0–1) for a product to pass the semantic retrieval filter.
# Code default is 0.65 (better recall/precision balance for dense catalogs). Set to 0.75
# for tight, small catalogs where precision matters more than recall.
SIMILARITY_THRESHOLD=0.65
# Quality-eval alert floor (0–1). A reply scoring BELOW this is flagged and PAUSES the AI on that
# conversation (there is no automatic resume).
#
# ⚠️ DO NOT raise this to 0.6 "to tighten quality". The eval model scores order confirmations a
# systematic ~0.200 — a known false low. At 0.1 that miscalibration is inert; at 0.6 EVERY order
# confirmation would flag and pause the AI at checkout. This file shipped 0.6 until P0-2 reconciled
# it. The right fix is moving the eval off the send path (P3-4), not a higher floor.
QUALITY_THRESHOLD=0.1
# Minimum purchase-intent score to create a draft order. Must be strictly >0 and <1: any other
# value is rejected and 0.85 is used instead (P2-7 logs the rejection at boot; it used to be
# silent, so INTENT_THRESHOLD=1 quietly became 0.85 — the opposite of "never auto-order").
INTENT_THRESHOLD=0.85
# Sampling temperature for the customer-facing reply (0–1).
# NOTE: a low temperature reduces run-to-run variation, it does NOT eliminate it. At this default,
# replaying one fixed prompt 8x produced up to 8 different replies. For a deterministic reply, set
# FACTS_USED_CONTRACT=true (temperature 0 + a fixed seed), not a lower temperature here.
AI_REPLY_TEMPERATURE=0.3
# Messages loaded for AI context. Every AI decision path (reply generation, intent, product
# resolution) uses this same slice, so raising it raises prompt cost across all of them.
AI_HISTORY_FETCH_LIMIT=40
# How long the AI holds off after a human agent replies, in minutes.
HUMAN_HOLD_MINUTES=10
# Session boundary for order-commission eligibility, in hours.
COMMISSION_SESSION_GAP_HOURS=3
# Per-conversation processing lock TTL (ms).
AI_CONVERSATION_LOCK_TTL_MS=300000

# --- Config validation (P2-7) ---
# Posture for the boot-time config checks: off | warn (default) | strict.
#
# IMPORTANT: this does NOT control whether a bad config kills the server. A runtime boot NEVER exits
# on an out-of-band or unparseable knob in any mode — it warns loudly and starts, because a mis-set
# deploy must not become an outage. It still exits(1) for a missing REQUIRED variable, a
# wrong-dimension embedding model, and weak/duplicate production secrets.
# The hard gate is a separate program: `npm run config:check` (run in CI), which exits(1) on any
# violation. `off` merely silences the band warnings.
# STRICT_CONFIG_VALIDATION=warn
# Record this instance's config fingerprint in the config_fingerprints table at boot, so a drifted
# multi-instance deploy is detectable with:
#   SELECT count(DISTINCT hash) FROM config_fingerprints WHERE last_seen > now() - interval '10 min';
# (>1 = the fleet disagrees with itself). The always-on `[config] fingerprint=...` boot log carries
# the same value when this is off. Default: false
# CONFIG_FINGERPRINT_REGISTRY=true

# --- Hallucination guards (P0-2) ---
# When true, the price and product-name hallucination guards validate replies against
# the tenant's FULL active catalog (+ AI-config ground-truth prices) instead of the
# per-turn retrieval window, and run even when that window is empty. Default: false
# (legacy matchedProducts-scoped behaviour). Flip in staging first.
# GUARD_VALIDATE_AGAINST_FULL_CATALOG=true
# Minimum pg_trgm word_similarity (0–1) for a suspected name to count as a real
# catalog item in the name guard's deterministic verification. Default: 0.48 —
# empirically calibrated (2026-07-12, 257-product dev catalog): real typo/phonetic
# mentions score 0.500–0.870, pure fabrications 0.143–0.467; 0.48 is the midpoint of
# the gap. Lower toward 0.4 if real typo'd names still escalate; raise toward 0.7 only
# to catch invented near-variants (e.g. "Gold Standard Casein" = 0.667) at the cost of
# escalating heavier typos. Full corpus in catalogGuardReferenceService.ts.
# NAME_GUARD_SIMILARITY_THRESHOLD=0.48
# Max full-catalog names handed to the name-guard LLM classifier when the retrieval
# window is empty (deterministic verification stays uncapped, so correctness does NOT
# depend on this — it only bounds prompt tokens: 150 names ≈ 1.3K tokens; a 5k-product
# catalog would be ~45K tokens, so do NOT raise this to "cover" large catalogs).
# Default: 150
# NAME_GUARD_LLM_CATALOG_CAP=150
# TTL of the cached guard reference sets (seconds). Caches are also invalidated on
# product/AI-config mutation, so this only bounds cross-instance staleness vs. rebuild
# frequency (rebuild is one indexed query, ~3ms at 257 products, ~60ms at 5k). Default: 120
# GUARD_CATALOG_CACHE_TTL_SECONDS=120

# --- Product-information gap gate (P0-3) ---
# When true, the gap gate escalates only on DETERMINISTIC evidence (a requested
# structured attribute absent from catalog fields, packaging reads, and the
# availability classifier, or an allowlisted free-form info gap such as ingredients);
# the LLM assessor's stochastic "missing" labels alone never escalate, and an assessor
# transport/parse error fails OPEN (the grounded AI reply is sent as-is) instead of
# replacing the reply with a holding message. Default: false (legacy fail-closed,
# LLM-driven escalation). Flip in staging first.
# GAP_GATE_DETERMINISTIC_FIRST=true

# --- Consolidated grounding gate + facts_used contract (P2-1) ---
# The permanent replacement for the P0-2/P0-3 interim guards. Two flags, both default OFF
# (flag-off = legacy generation + guards, byte-for-byte).
#
# FACTS_USED_CONTRACT: when true, the customer reply is generated DETERMINISTICALLY
# (temperature 0 + a fixed seed) with a json_schema response_format returning
# { facts_used, prose }, so its asserted facts can be validated against the catalog (RC-03).
# Applied only to the non-vision text path; skipped for custom_model_id (fine-tuned) tenants.
# Turning this ON while GROUNDING_GATE_CONSOLIDATED stays OFF is the SHADOW window: declared
# facts are emitted + persisted in the decision ledger while the legacy guards still decide.
# FACTS_USED_CONTRACT=true
# Fixed seed for the deterministic reply completion (RC-03). Default: 7
# AI_REPLY_SEED=7
# max_tokens for the contract completion (768 prose budget + JSON wrapper headroom). A truncated
# structured output is treated as a retryable generation failure. Default: 1200
# FACTS_CONTRACT_MAX_TOKENS=1200
#
# GROUNDING_GATE_CONSOLIDATED: when true, ONE deterministic gate replaces the legacy price +
# product-name hallucination guards and forces the gap gate onto its deterministic-first decision.
# It validates asserted prices/names against the tenant's FULL active catalog and takes TARGETED
# action on the failing span (removes only the offending sentence; never a blanket replace — the
# fcd0af7e fix). A catalog-index infra error fails CLOSED with the distinct retryable alert reason
# grounding_check_unavailable. NOTE: this ONE flag enables the price AND name dimensions together
# (the spec's per-dimension sub-flags were not implemented); the rollback unit is the whole gate —
# flag-off reverts to the P0-2/P0-3 interim guards. Meaningful with FACTS_USED_CONTRACT, but the
# gate also has a deterministic prose backstop so it still validates when no facts were declared.
# GROUNDING_GATE_CONSOLIDATED=true
# Minimum grounded characters that must survive a targeted strip before the gate escalates the
# whole turn to a holding message instead (stops a reply that is nothing but a fabricated fact from
# being sent as a near-empty message). Default: 24
# GROUNDING_GATE_STRIP_FLOOR=24

# --- Sensitive-escalation fail-closed (P0-4) ---
# When true, the pre-reply sensitive-escalation subsystem fails CLOSED. A sensitive
# detector throw (cancellation/refund, wrong-product, post-purchase, order-info) routes
# to the safe escalation path (pause + human_replied=false + alert + neutral holding
# message) instead of silently downgrading a refund/cancellation demand into a normal
# sales reply; any other pre-send throw in the block re-throws so BullMQ retries; a throw
# AFTER an ack was delivered STOPS the job (no re-throw — RC-20 — and no fall-through to
# a sales reply after a sensitive ack); and the post-send intent/draft-order swallow
# surfaces as a durable order_detection_failed alert. Default: false (legacy fail-OPEN
# umbrella: warn + continue). Enable together with (or after)
# RATE_LIMIT_COUNT_DELIVERED_ONLY: with legacy attempt-counting still on, the re-throw
# retries would burn 25/h budget with zero replies (RC-18 amplified). Flip in staging
# first, with a "refund demand during an OpenAI blip" fault-injection as the gate.
# SENSITIVE_PATH_FAIL_CLOSED=true
# STAGING/TEST ONLY — never in production. Forces a sensitive detector to throw so the
# P0-4 fault-injection gate is a reproducible one-command check instead of a manual
# exercise: set to 'cancellation_refund' | 'wrong_product' | 'post_purchase' |
# 'order_info' | 'any', send a matching message (e.g. "dua rimbursim"), and assert the
# outcome is escalate (alert + pause + holding message), never a sales reply. Logged
# loudly at boot when armed; inert when unset. Redis/Lua contracts have their own local
# integration suite: `npm run test:integration` (requires a reachable Redis).
# TEST_FORCE_DETECTOR_ERROR=cancellation_refund

# --- Rate-limit delivered-only counting (P0-6) ---
# When true, the per-conversation 25/h AI-reply budget counts only real DELIVERED replies,
# keyed idempotently on the inbound message id, so BullMQ retries / stale-skipped /
# disabled-AI / rescheduled jobs never burn budget (the RC-18 phantom increments that
# tripped the cap → persistent ai_paused + rate_limit_exceeded → permanent silence). The
# cap is enforced by a read-only pre-send check; the increment is post-send. Default:
# false (legacy pre-gate INCR per job attempt). Flip in staging first.
# RATE_LIMIT_COUNT_DELIVERED_ONLY=true
# Per-conversation AI replies allowed per rolling hour (both counting modes). Default: 25.
# AI_MAX_REPLIES_PER_HOUR=25

# --- Classifier consolidation (P2-2, RC-07/08/22/10) ---
# ORDER_STAGE_MACHINE: the deterministic order-lifecycle state machine that replaces three
# per-turn LLM order-classifiers (classifyNewOrderSignal, detectOrderAffirmationIntent, and the
# ~40-call order-closing loop). Because the consent path is a stage-gated lexicon check with NO
# confidence field, RC-07's boost asymmetry and RC-22's 7-conjunct boundary flip vanish. Tri-state:
#   off    (default) — legacy LLM order-classifiers decide; the FSM never runs; no slot-store writes.
#   shadow           — legacy still decides + acts, but the FSM verdict is computed and any
#                      divergence is logged ([ORDER_STAGE_DIVERGENCE]) + recorded in the decision
#                      ledger; the slot store (migration 077) accumulates state for the next turn.
#   on               — the FSM is authoritative for order creation; the three LLM classifiers are
#                      skipped. Requires migration 077. Flip in staging after a shadow-parity window.
# ORDER_STAGE_MACHINE=shadow
#
# COMMISSION_STORED_TIMESTAMP: when true, the AI-order commission human-participation window anchors
# on the STORED consent-inbound timestamp instead of NOW() and bounds the window at it, so a retry /
# late run (or a human reply during retry latency) can't flip is_commissionable (RC-22). Default:
# false (legacy NOW()-relative query). Pairs with ORDER_STAGE_MACHINE.
# COMMISSION_STORED_TIMESTAMP=true
#
# STICKY_LOCALE_SLOT: when true, the resolved reply locale is a sticky per-conversation slot
# (migration 077 reply_locale) — reused unless the current turn carries a high-confidence
# unambiguous opposite-language marker (hysteresis), so ambiguous turns can't flip the language and
# the stochastic LLM language call is skipped (RC-10). Default: false (per-turn detection).
# STICKY_LOCALE_SLOT=true
#
# INTENT_STRUCTURED_CONTRACT: when true, the purchase-intent detector uses a strict json_schema
# response_format with a Zod-validated payload; a malformed/truncated output throws a retryable
# error instead of the legacy fail-open all-zero intent. Default: false (legacy json_object).
# INTENT_STRUCTURED_CONTRACT=true

# --- Memory & history redesign (P2-3, RC-16/13/17) ---
# Three independent flags; each reverts alone. Flag-off is byte-for-byte the legacy behaviour.
#
# HISTORY_DELIVERY_FILTERED: when true, the reassembled AI history drops never-delivered
# (send_status='failed') non-customer rows and RELABELS delivered-but-non-authoritative rows —
# flagged low-quality replies AND canned holding/escalation/procedural copy — from `assistant` to
# `system`, so the model stops re-conditioning on its own bad/phantom prior output (RC-16). There is
# no positive "delivered" column, so exclusion keys on 'failed' only; NULL is treated as delivered.
# Default: false (binary sent_by==='customer'?user:assistant map).
# HISTORY_DELIVERY_FILTERED=true
#
# SUMMARY_SLOT_BACKED: when true, the older-context summary is rebuilt from the persisted slot store
# (name/phone/address/order_stage, migration 077) + the last-recommendation anchor (migration 078,
# resolved to still-in-stock products) plus a bounded extractive tail — so load-bearing facts survive
# past the 40-row window and the AI never re-asks a provided field or denies a previously-recommended
# in-stock product (RC-13). Also enables the per-turn slot writes that feed it. Requires migrations
# 077 + 078. Default: false (legacy customer-message-only summarizer; no slot writes).
# SUMMARY_SLOT_BACKED=true
#   SUMMARY_SLOT_BACKED_MAX_TAIL_CHARS: hard cap on the summary's extractive tail (RC-26 token guard).
#   Default: 600.
# SUMMARY_SLOT_BACKED_MAX_TAIL_CHARS=600
#
# AI_CONFIG_VERSIONED_CACHE: when true, the per-tenant ai_config cache (and its prompt-blocks twin)
# is keyed by a monotonic version (the row updated_at as epoch-micros) and written with a Lua
# SET-IF-NEWER; every ai_config-row mutator (admin edit, restore, the AI toggle, fine-tune) also
# write-throughs the fresh row — closing the delete-only resurrection race and healing C-55 (the AI
# toggle never invalidated). Uses a distinct `ai_config:v:{tenant}` key namespace. Default: false
# (legacy EX 900 delete-only; C-55 unhealed).
# AI_CONFIG_VERSIONED_CACHE=true

# --- Albanian/Gheg capability + prompt hygiene (P2-5, RC-25/26/10/15) ---
# Four independent flags; each reverts alone. Flag-off is byte-for-byte the legacy behaviour.
# WF-E scored Albanian 54/100 in the core Kosovo/Gheg market; these are the deterministic fixes.
#
# GHEG_LEXICONS: when true, curated Kosovo/Gheg forms are CONCATENATED onto the routing lexicons
# (never substituted, so the additions can only ever match MORE, never less), and an
# other-options browsing question is excluded from the fail-closed product-information-gap path.
# This is the EV-010 fix: "A keni ma shum a veq aito / Qito" ("do you have more, or only these?")
# slipped every regex — 'ma shum' misses `me shum[eë]`, 'aito'/'Qito' miss the deictic list — so an
# inventory question reached the English-prompted gap assessor and came back as
# missing_info:["ma shum"]: the word "more", filed to a specialist as a missing catalog attribute.
# Also adds Gheg markers to the reply-language heuristic (RC-10) — under STICKY_LOCALE_SLOT that
# heuristic is the SOLE inbound-marker source, and pure-Gheg turns resolve to null today.
# Consent additions go ONLY to the order_stage FSM's lexicon, which is stage-gated to
# `awaiting_confirmation`; the un-gated legacy affirmation check is deliberately untouched.
# Default: false.
# GHEG_LEXICONS=true
#
# DIALECT_NORMALIZATION: when true, the LEXICAL retrieval arm folds diacritics + Gheg function
# words through one shared normalizer and uses a single unified stopword list. Today
# `extractKeywords` KEEPS diacritics while its sibling `extractCatalogSearchPhrases` STRIPS them —
# from the same message, in the same call — so one arm searches %çokollatë% and the other
# %cokollate% against a catalog that is spelled inconsistently and customers who type no diacritics
# at all (0 of 40 real messages did). Scope is deliberately the lexical arm ONLY: the embedding arm
# is already query/doc consistent (raw/raw) and normalizing it would flip the sha256 input hash for
# 100% of rows, forcing a full re-embed at 200/6h with both vector generations live meanwhile.
# Content words are EXPANDED (raw form retained) rather than rewritten, so the catalog's own
# "Qokolad" stays reachable. Default: false.
# DIALECT_NORMALIZATION=true
#
# RESTRICTIONS_FOOTER_ALL_TENANTS: when true, the code-owned platform rulebook
# (services/platformPolicy.ts, business.md's 17 rules in sq + en) renders in the restrictions
# footer for any tenant whose `ai_configs.platform_restrictions` is empty. `buildRestrictionsFooter`
# was never broken — this is a DATA gap: `restrictions` is populated on 1 of 6 tenants and
# `platform_restrictions` is [] on ALL 6, so five tenants run with no business rules in-prompt and
# the "PLATFORM POLICY" section has never rendered in production. A tenant's own
# `platform_restrictions` still wins as an admin override. Default: false.
# RESTRICTIONS_FOOTER_ALL_TENANTS=true
#
# PROMPT_ALLOWLIST_BUDGET: when true, (1) only migration-defined guideline keys and `custom_*`
# blocks render — dropping the orphan `guidelines.offers_promotions` (admin-created, in no
# migration, catalog is_active=false, yet enabled on 6/6 tenants) which injects ~1478 chars telling
# the model to use an "Active offers" section the code never populates; (2) the assembled
# guidelines are char-budgeted, dropping custom_* first, then non-protected blocks, NEVER the
# language lock / catalog-integrity / order-flow blocks and never the footer (an over-budget prompt
# is a degradation; a missing policy footer is a breach); (3) the full prompt is checked against a
# reporting threshold and asserted to reference no unpopulated section; (4) three history-budget
# defects are fixed (the dead system-prompt estimate, the mismatched eviction subtraction, and the
# un-evictable summary weight that pinned the loop at its 4-message floor). Default: false.
# PROMPT_ALLOWLIST_BUDGET=true
#   PROMPT_GUIDELINES_MAX_CHARS: TRUNCATING cap on the assembled guideline blocks (~17.9K live,
#   ~16.4K once the orphan is dropped). Default: 20000.
# PROMPT_GUIDELINES_MAX_CHARS=20000
#   PROMPT_ASSEMBLY_MAX_CHARS: REPORTING threshold on the FULL system prompt (guidelines + catalog
#   + business profile + always-on appends + footer). Nothing is truncated against it — it is the
#   RC-26 "the system prompt is unbudgeted" instrument. Live prompts measure 26–33K chars, so the
#   default reports genuine outliers rather than the status quo. Default: 34000.
# PROMPT_ASSEMBLY_MAX_CHARS=34000

# --- AI auto-resume (P0-5) ---
# When true, the AI stops going permanently silent after an escalation:
#  (2) resolving a NON-sensitive alert without an explicit resume_ai resumes the AI —
#      but only for an AUTOMATED pause (ai_paused_at stamped) with no OTHER open
#      sensitive alert on the conversation; cancellation/refund/post-purchase alerts,
#      manual pauses, and legacy NULL-metadata pauses always require an explicit resume;
#  (3) a new inbound on a rate_limit_exceeded pause whose 25/h counter has rolled over,
#      with no open sensitive alert and no active human hold, clears the pause and answers;
#  (4) an hourly invariant monitor logs conversations left paused past a newer inbound with
#      no open alert of any kind (observational only — no writes).
# Requires RATE_LIMIT_COUNT_DELIVERED_ONLY for part 3 to be meaningful (the counter must
# reflect delivered replies, not phantom attempts). Default: false. Flip in staging first.
# AI_AUTO_RESUME=true
# Cron for the part-4 invariant monitor (observational). Default: hourly.
# AI_PAUSE_INVARIANT_MONITOR_CRON=0 * * * *

# --- AI self-echo durable corroboration (P0-7) ---
# When true, a native IG/FB echo with no app_id (which the app_id heuristic would treat as a
# human handoff) is corroborated against a recently-persisted outbound we sent before being
# classified as human. Prevents the AI's own Instagram reply — on a self-send registry miss
# (Redis hiccup / evicted key / TTL expiry) — from setting sticky human_replied (which
# disqualifies the use-case fee) + a 10-min human hold + a phantom sent_by:'human' row
# (RC-24). Fails toward "not human"; a Redis read error is logged distinctly. Default: false
# (legacy app_id-only classification). Flip in staging first, with a "Redis-down + IG AI reply
# echo" fault-injection asserting no human_reply_sent and no hold.
# ECHO_DURABLE_CORROBORATION=true

# --- Idempotent post-send pipeline (P1-1) ---
# RC-20 (crash-after-send dead-letters or duplicates a delivered reply) and RC-21 (a persisted
# inbound message whose ai.reply job was lost → permanent artifact-free silence). All additive and
# default OFF; each flag ships independently. Recommended rollout: enable the relay in shadow +
# inbound outbox, verify the relay drains, then flip dispatch, then scoped-read, then stage-before-
# send per channel (WhatsApp first — the null-send-id worst case). Migration step 5 (dropping the
# global UNIQUE + legacy paths) is a separate later PR.
#
# Run the outbox relay drain loop (jobs/outboxRelay.ts). Shadow when dispatch is off: it claims +
# drains rows (proving the SKIP-LOCKED plumbing) but performs no effect. Default OFF.
# OUTBOX_RELAY_ENABLED=true
# The relay actually dispatches effects (enqueues ai.reply / usecase.eval, writes analytics/alerts,
# charges the delivered-reply rate count). Requires OUTBOX_RELAY_ENABLED. When on, the inbound path
# drops its legacy direct aiQueue.add (the relay owns delivery), and — with stage-before-send on —
# the staged reply's deterministic side-effects (analytics.ai_reply_sent, usecase.eval,
# reply.ratecount, send-failure / missing-image alerts) are written as outbox rows INSIDE the flip
# transaction and performed exactly-once by the relay, closing the crash-after-flip loss window.
# When off (shadow) the legacy inline paths still deliver. Default OFF.
# OUTBOX_DISPATCH_ENABLED=true
# Relay poll cadence in ms (the debounce delay lives in each row's available_at, not here). Default 1000.
# OUTBOX_RELAY_INTERVAL_MS=1000
# Relay claim batch size and lease before a crashed-mid-dispatch row is re-claimed (seconds).
# OUTBOX_RELAY_BATCH_SIZE=50
# OUTBOX_RELAY_LEASE_SECONDS=120
# RC-21: persist the inbound message row AND the ai.reply enqueue-intent in ONE transaction, and
# re-check the live intent on a duplicate (re-enqueue if missing) instead of the bare early-return.
# Replaces the racy getJobs→remove→add debounce with a single-live-intent upsert. Default OFF.
# INBOUND_OUTBOX_ENQUEUE=true
# RC-21: ACK the webhook 200 only AFTER the inbound job is enqueued, releasing the webhook_seen claim
# on failure so Meta's retry is honored (instead of ack-then-fire-and-forget losing a failed enqueue).
# Independent of the others. Default OFF.
# WEBHOOK_ACK_AFTER_ENQUEUE=true
# RC-20 / C-114: inbound dedupe reads the tenant-scoped (tenant_id, external_message_id) index so two
# tenants can carry the same channel message id. Requires migration 071 (landed). Default OFF.
# MESSAGES_SCOPED_UNIQUE_READ=true
# RC-20: stage the AI reply durably BEFORE the channel send and flip staged→sent while persisting the
# delivered row with ON CONFLICT (tenant_id, external_message_id) DO NOTHING (no dead-letter, no
# WhatsApp duplicate-with-fresh-text; the staged text is authoritative and never re-generated). The
# canned pre-reply sends (holding / ack / order-confirmation / clarify) are staged under their own
# reply slots too. Escalation/quality pause+alert commit ATOMICALLY inside the flip transaction, and
# a retry of a delivered reply no-ops the send, skips the committed side-effects, and resumes ONLY an
# interrupted order-detection tail (marker-guarded, duplicate-order-safe). Default OFF. Roll out per
# channel via the allowlist below (WhatsApp first). Requires migration 071.
# AI_REPLY_STAGE_BEFORE_SEND=true
# CSV allowlist of channel types to stage (empty = all). e.g. whatsapp then whatsapp,facebook,instagram,viber.
# AI_REPLY_STAGE_BEFORE_SEND_CHANNELS=whatsapp
# Secondary per-staging-row send-attempt cap (under BullMQ's own attempts). Default 5.
# AI_REPLY_STAGE_MAX_SEND_ATTEMPTS=5

# --- Confidence contract symmetry + threshold hysteresis (P1-3) ---
# RC-07/RC-08. When true, the confidence contract is symmetric across all five intent
# detectors: a missing/zero `confidence` never auto-passes a gate. The four escalation
# detectors (cancellation/refund, wrong-product, post-purchase, order-info-update) drop
# their inline 0→0.9/0.85 boost, so a model that asserts the intent boolean but omits
# confidence no longer clears its >0.8/>0.82 gate on the boolean alone — the path abstains,
# the single consistent fail-direction the order/affirmation path already had (its
# deterministic order-stage slot check — consent lexicon + non-empty address + phone —
# keeps it from forfeiting revenue). Every hard gate also gains a symmetric abstain band so
# boundary scores resolve deterministically instead of flipping outcome-class run-to-run.
# Default: false (legacy per-site boosts + hard `>` gates, byte-for-byte). Flip in staging
# first; watch [CONFIDENCE_CONTRACT] (boost-would-have-applied frequency) and
# [CONFIDENCE_GATE] (boundary-abstain rate) to measure before prod.
# CONFIDENCE_CONTRACT_SYMMETRY=true
# Half-width of the abstain band around each hard confidence gate (only active when
# CONFIDENCE_CONTRACT_SYMMETRY is on). A score within ±band of the threshold resolves to
# abstain (never fires) AND raises a non-pausing `confidence_band_abstain` ai_alert so an
# in-band refund demand / warm order lead is reviewed by a human instead of vanishing into a
# normal reply. The effective band is capped at (1 - threshold) so a gate can never become
# permanently unpassable. Clamped to [0, 0.25]. Default: 0.05.
# CONFIDENCE_HYSTERESIS_BAND=0.05
# RC-08: persist each intent detector's verdict per (conversation, logical inbound) in Redis
# (6h TTL, key ai_clf:{conversationId}:{inboundExternalId}:{detector}) so a BullMQ retry
# consumes the first attempt's verdict instead of re-rolling the stochastic classifier —
# without this a 0.86 that gated "escalate" can come back 0.83 on the retry and flip the
# outcome class. Fail-open on Redis errors (verdicts recompute). Default: false.
# CLASSIFIER_VERDICT_PERSISTENCE=true

# --- PII redaction boundary (P1-6) ---
# SEC-5/OBS-7. The single compliance switch for customer PII (names, phones, addresses, health
# context) in logs and durable telemetry. Redaction is ON by default and — unlike the other P1
# flags — should stay ON: it changes only logs/`ai_alerts.details` (no customer or billing
# behaviour), and turning it OFF re-exposes cleartext PII on an EU company, so disabling it must be
# a deliberate, compliance-owned decision. When ON: AI-path log sites replace verbatim customer
# text with a joinable hash reference `[pii len=N #hash]` (health-context-safe); model-output dumps
# and `ai_alerts.details` are pattern-masked to stable tokens (`[phone#1234]`, `[email#..]`,
# `[addr]`, keeping a phone last-4 for support correlation). Set to `false` ONLY as a gated
# escape hatch — boot then logs a loud `[REDACT_PII] DISABLED` warning. Backfill pre-existing
# alert rows with `npm run redact-alert-details` (idempotent). Default: true (redaction active).
# REDACT_PII=false

# Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Data stores ---
REDIS_URL=redis://127.0.0.1:6379

# --- Meta / channels ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://hypermetropic-ai-afflated.ngrok-free.dev/api/oauth/meta/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://hypermetropic-ai-afflated.ngrok-free.dev/api/oauth/instagram/callback
WEBHOOK_VERIFY_TOKEN=
# Optional legacy: was used to validate SPA redirect_uri for token exchange. Exchange no longer sends redirect_uri to Meta (FB.login code flow).
# You should still add your Channels page URL under Meta → Facebook Login for Business → Valid OAuth redirect URIs.
# WHATSAPP_EMBEDDED_SIGNUP_REDIRECT_URI=
# Partner Business Portfolio ID (Meta Business Manager). Used as fallback when resolving WABA from the embedded-signup token.
WHATSAPP_BUSINESS_ID=
# Embedded Signup configuration ID (used by the frontend Meta config).
WHATSAPP_CONFIGURATION_ID=
# Optional Graph API base for Business Management + WABA calls. Default: https://graph.facebook.com/v25.0
WHATSAPP_BUSINESS_MANAGEMENT_API=
# Optional legacy: not used by Embedded Signup token flow after code exchange (business token comes from oauth/access_token only).
# WHATSAPP_SYSTEM_USER_ID=
# Instagram/Facebook share normalization: max caption chars in stored message & AI context (0 = omit caption). Default 400.
INSTAGRAM_SHARE_CAPTION_MAX_CHARS=400
# Set to 1/true to log webhook signature failures and Instagram payload digests (no tokens).
WEBHOOK_DEBUG=
ENCRYPTION_KEY=

# --- Ops / optional ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ADMIN_KEY=
# Separate secret for platform-owner JWT (POST /api/admin/auth/login). Must differ from JWT_SECRET.
ADMIN_JWT_SECRET=
ALERT_WEBHOOK_URL=
QUEUE_HEALTH_DEPTH_WARNING=
FINETUNING_THRESHOLD=
FINETUNING_CRON=0 2 * * *
OPENAI_FINETUNING_BASE_MODEL=gpt-4o-mini-2024-07-18
OUTBOUND_API_MAX_PER_HOUR=200
OUTBOUND_API_WINDOW_SEC=3600

# --- Operational ---
# Graceful shutdown: how long to wait for in-flight BullMQ jobs to finish before
# forcing exit on SIGTERM/SIGINT. Should be > the longest expected AI reply time.
# Default: 25000 (25 s).
# SHUTDOWN_TIMEOUT_MS=25000

# Per-tenant AI reply concurrency cap. Jobs beyond this limit are re-delayed
# rather than starving other tenants. Default: 8.
# AI_MAX_CONCURRENT_PER_TENANT=8

# Redis memory monitoring thresholds (% of maxmemory). Fires ALERT_WEBHOOK_URL.
# Default: warn at 80%, critical at 90%.
# REDIS_MEMORY_WARNING_PCT=80
# REDIS_MEMORY_CRITICAL_PCT=90
# REDIS_MEMORY_CHECK_INTERVAL_MS=60000

# --- P1-2: dead-letter queue + failure classification + exhaustion alerting (RC-20/21/18) ---
# All off by default; each step is independently shippable.
# Step 1 — record-only shadow: the worker `failed` listener classifies each failure
# (transient/terminal/stalled) and writes exhausted/stalled/terminal jobs to the durable
# `dead_letter` table. No alerts. A stalled (SIGKILL-on-deploy) job is now recorded instead of
# silently dropped.
# DLQ_ENABLED=true
# Step 3 — exhaustion alerting: a newly dead-lettered job raises Sentry.captureException; a dead
# `ai.reply` job also creates a tenant-facing `ai_reply_undelivered` ai_alerts row + socket push;
# and every dead job enqueues an operator notification on the (revived) notifications queue.
# When on, the notifications queue takes over the operator webhook, so the legacy inline post is
# skipped (no double alert).
# DLQ_EXHAUSTION_ALERTS_ENABLED=true
# Step 4 — guarded operator replay: enables POST /api/admin/dead-letter/:id/replay, which re-enqueues
# a dead-lettered payload onto its origin queue. Safe because P1-1's idempotent staging/outbox make
# re-delivery exactly-once. 503 when off.
# DLQ_REPLAY_ENABLED=true
# Step 5 — DLQ growth monitor + breaker + retention prune (started in server.ts when on).
# DLQ_METRICS_ENABLED=true
# One aggregated breaker alert fires when the last hour's dead-letter count crosses this. Default 25.
# DLQ_ALERT_BURST_THRESHOLD=25
# Monitor tick interval (ms). Default 60000.
# DLQ_METRICS_INTERVAL_MS=60000
# Prune already-actioned (replayed/ignored) dead_letter rows older than this many days. Never touches
# un-actioned ('new') rows. Default 30.
# DLQ_RETENTION_DAYS=30

# --- P1-5: AI decision ledger (RC-03/17/01/02/04/22) ---
# Persist, per reply, everything the Phase-15 §15.2 reconstruction needs (prompt provenance,
# model/params, token usage + cost, retrieval scores/threshold outcomes/semanticSkipped, the
# per-classifier decision chain) into the append-only `ai_decision_ledger` (migration 073), plus a
# fail-closed-vs-genuine flag on every `ai_alerts` row (migration 074). Customer text is redacted at
# the boundary (REDACT_PII). Default OFF — inert until on. The main-reply row is written THROUGH
# P1-1's outbox in the reply-flip txn, so the full main-path ledger also needs
# AI_REPLY_STAGE_BEFORE_SEND + OUTBOX_RELAY_ENABLED + OUTBOX_DISPATCH_ENABLED (topic 'ledger.write');
# early-return paths ([NO_REPLY], sensitive acks, legacy send) write best-effort directly.
# AI_DECISION_LEDGER_ENABLED=true
# Optional per-model token price overrides (USD per 1M tokens) for the ledger's COGS column, as a
# JSON map. Falls back to the built-in table; an unpriced model records null cost (never a fake 0).
# OPENAI_MODEL_PRICES={"gpt-4o":{"inputPerM":2.5,"outputPerM":10}}
# P2-4 Part 2: ledger retention. Every reply writes a row carrying a redacted prompt preview derived
# from customer conversation text, so the table must expire — GDPR as much as disk. The sweep starts
# only when AI_DECISION_LEDGER_ENABLED is on (nothing to prune otherwise) and deletes in bounded
# batches. Default 90 days.
# LEDGER_RETENTION_DAYS=90
# LEDGER_RETENTION_INTERVAL_MS=3600000

# --- P2-4 Part 1: structured, correlation-keyed logging (C-109 / OBS-*) ---
# FORMAT switch for the AI-path logger (utils/logger.ts). Default OFF → legacy `console[level](tag,
# meta)` lines, byte-for-byte unchanged. ON → one JSON line per log call carrying the per-message
# correlation ids (traceId, correlationId=messageExternalId, tenantId, conversationId), so
# grep-by-correlationId reconstructs a single reply's whole lifecycle across generateReply + the
# classifiers. Independent of REDACT_PII (which always masks PII in log metadata) and of Sentry
# (logger.error reports to Sentry via SENTRY_DSN regardless of this flag). No behaviour change to
# the reply pipeline either way.
# STRUCTURED_LOGGING=true

# --- P2-4 Part 2: receipt-time snapshot + dedupe replay (RC-06/RC-11/RC-17) ---
# The deliberate delay between a message being RECEIVED and its ai.reply job running. This is the
# window RC-06 is about: a toggle flipped inside it changes an already-received message's outcome.
# Documented here because it defines that window and every reasoning about it — it was previously
# undocumented despite being read on both enqueue paths. Default 8000.
# AI_REPLY_DELAY_MS=8000
#
# RECEIPT_TIME_SNAPSHOT: capture the enablement/config state at receipt into the ai.reply payload,
# compare it against the live state the gates read ~8s later, and write both plus the divergence to
# the decision ledger — including on the gate-DROP paths, which previously produced no artifact at
# all (RC-06's literal complaint: "no artifact that a received message was discarded").
#
# RECORD-ONLY BY DESIGN. The gates keep reading live state; the snapshot never overrides them. This
# is deliberate, not a half-measure — RC-06's own prescription offers "evaluate against the snapshot
# (or record it)", and governing the gates from a snapshot would blind a merchant's kill switch
# (toggling a pause writes no message row, so the pre-send human-takeover check cannot backstop it),
# dead-code the P0-5 rate-limit auto-resume into RC-14's permanent-silence dead-end, and re-introduce
# exactly the ai_config staleness P2-3 removed (C-55).
#
# The snapshot's ONE governing use is the RC-17 staleness floor: a cached ai_config older than the
# version in force at receipt is re-read from DB instead of served. That needs a versioned cache to
# compare against, so it is INERT unless AI_CONFIG_VERSIONED_CACHE=true (boot logs say which).
# Capture costs +1 narrow SELECT per inbound when on, and exactly zero when off. Default OFF.
# RECEIPT_TIME_SNAPSHOT=true
# Persist the FULL redacted system prompt content-addressed in ai_prompt_blobs (migration 082);
# the ledger row's prompt.system_hash joins to it, closing the 15.2 "recover the prompt from the
# ledger alone" residue (the inline preview is capped at 12K chars of a 26-33K prompt). Deduped by
# hash, pruned on the same LEDGER_RETENTION_DAYS window. Default: false
# LEDGER_PROMPT_BLOBS=true
#
# WEBHOOK_DEDUPE_REPLAY: drop the 300s wall-clock freshness gate in both webhook controllers.
# That gate never worked in either direction: a payload with NO timestamp scored |now-now|=0 and
# always passed however old, while a payload WITH an old timestamp was 403'd forever (Meta redelivers
# the same stale timestamp), silently dropping valid late messages — including retries WE requested
# via WEBHOOK_ACK_AFTER_ENQUEUE's 500. It is not an auth control: HMAC is verified before it and is
# unaffected. ON → replay protection is HMAC + the per-message `webhook_seen` claim + the durable DB
# dedupe in processInboundMessage. Ships with its prerequisites (per-message dedupe key aligned to
# what the normalizer consumes, applyMessageEdit revision-monotonicity, message-scoped pending-job
# removal) — without those, removing the 403 would open a durable content-rewrite primitive.
# Default OFF (legacy skew gate + legacy dedupe key, byte-for-byte).
# WEBHOOK_DEDUPE_REPLAY=true

# --- Retrieval tuning ---
# HNSW ef_search candidate pool size. The HNSW index is global (not per-tenant), so
# the post-filter by tenant_id consumes candidates. Raise this if semantic search
# returns too few results for small-catalog tenants in multi-tenant deployments.
# Must be >= FOCUSED_PRODUCT_MATCH_LIMIT. Default: 100.
# HNSW_EF_SEARCH=100

# --- Retrieval reliability (P1-4 / RC-04) ---
# Timeout (ms) for the per-message OpenAI query-embedding call. Now a HARD abort deadline —
# an AbortController actually cancels the request (the old Promise.race merely abandoned it).
# On timeout the semantic path is skipped, the skip is negative-cached, and keyword/phrase
# search still runs (fail-open). The deadline dominates any 429/5xx SDK backoff, so this is a
# fast fail-open to lexical retrieval, not a 429-survival path. Default: 5000.
# EMBEDDING_QUERY_TIMEOUT_MS=5000
# Share POSITIVE query embeddings across workers via Redis (keyed by model+hash(text)), so the
# fleet converges on one vector. Default false → in-process Map only (today's behaviour, byte-
# for-byte). The NEGATIVE (skip) cache is Redis-backed regardless — that is the cross-worker
# re-race fix at negligible memory. Positive sharing adds a hot-path consumer to the 192 MB
# noeviction Redis, so it is gated + short-TTL'd + Float32-encoded; flip per env after observing
# footprint. Fail-open: a Redis error degrades to compute, never fails the reply.
# RETRIEVAL_SHARED_CACHE=true
# TTL (s) for shared positive query-embedding vectors (bounds the noeviction footprint). Default 600.
# RETRIEVAL_POS_CACHE_TTL_SECONDS=600
# TTL (s) for negative (skip) sentinels — how long a timed-out/failed query stops re-racing.
# Short so recovery is fast; per-exact-text so blast radius is bounded. Default 30.
# An explicit 0 is the kill switch: negative caching disabled entirely (P1-4 rollback flag).
# RETRIEVAL_NEG_CACHE_TTL_SECONDS=30
# RC-04 closing criterion: the semanticSkipped metric WITH an alert threshold. When this many
# semantic skips land inside the window, ONE Sentry burst alert fires (per window). 0 = off.
# Defaults: 20 skips / 300 s.
# SEMANTIC_SKIPPED_ALERT_THRESHOLD=20
# SEMANTIC_SKIPPED_ALERT_WINDOW_SECONDS=300
# Similarity hysteresis half-band around SIMILARITY_THRESHOLD (0.65). Candidates in
# [threshold - band, threshold) join a SEPARATE low-weight `semantic_band` RRF source (never the
# full 2.0 semantic weight), so a weak boundary vector only ranks with corroboration. 0 (default)
# ⇒ band always empty ⇒ retrieved sets identical to today. Clamped to [0, 0.15]. Measure before
# raising: EV-043 shows same-category noise scores 0.54–0.59, so a wide band re-admits noise.
# SIMILARITY_HYSTERESIS_BAND=0
# RRF weight of the hysteresis-band source (core semantic stays 2.0). Default 1.0.
# SEMANTIC_BAND_WEIGHT=1.0
# Extra rows fetched from the similarity search when the band is active, so band candidates are
# not starved by the SQL LIMIT. Only applied when SIMILARITY_HYSTERESIS_BAND > 0. Default 5.
# SEMANTIC_BAND_EXTRA_DEPTH=5

# Embedding reconciliation scheduler: cron and max products re-queued per run.
# EMBEDDING_RECONCILE_CRON=0 */6 * * *
# EMBEDDING_RECONCILE_BATCH_LIMIT=200

# --- P2-6: circuit breaker + graceful degradation + provider-failure isolation (RC-19/04) ---
# All off by default. OPENAI_TIMEOUT_MS is PER ATTEMPT, so with OPENAI_MAX_RETRIES=3 a single call
# can occupy 60s x 4 = 240s while holding the per-conversation lock; and during a blip the pipeline
# degrades INCOHERENTLY (sensitive path fails open into a sales reply, gap gate fails closed into an
# escalation). These knobs bound the worst case and give the whole turn ONE posture.
#
# ORDER MATTERS — this is a safety property, not a preference:
#
# Step 1 — the safe floor, FIRST. Any provider failure/fast-fail/starved call recorded during a turn
# makes that turn resolve to a templated holding reply + a `provider_unavailable` escalation instead
# of a reply built on starved, fail-open guards. Turn-level by design: ~21 classifiers swallow errors
# into fail-open defaults, so a per-catch floor would be bypassed. Enabling any cap below WITHOUT
# this is a regression — a cap shorter than a blip aborts the refund detector and ships a sales reply
# to a refund demand (RC-19, but faster).
# GRACEFUL_DEGRADE_MODE=true
# Step 2 — the caps, WITH step 1 on. Hard cap on one call including the SDK's retry chain, and a
# total budget for one turn's ~25-call fan-out. 0 = off (the default).
# Keep OPENAI_TURN_DEADLINE_MS x2 under AI_CONVERSATION_LOCK_TTL_MS (300000, never renewed): the
# budget is rearmed before the send so the post-send order-detection tail is bounded too.
# OPENAI_CALL_TIMEOUT_MS=45000
# OPENAI_TURN_DEADLINE_MS=120000
# Step 3 — breaker bake-in. `monitor` records would-open transitions against a real provider without
# changing behaviour. Promote to `on` only after monitor shows a clean healthy-provider baseline.
# OPENAI_CIRCUIT_BREAKER=monitor
# Consecutive provider-availability failures before opening. 429 does NOT count (the provider is up
# and rate-limiting our own burst — a bulk import must not open the reply path's breaker), and
# neither does our own deadline abort. Default 5.
# OPENAI_BREAKER_FAILURE_THRESHOLD=5
# Fast-fail window before a half-open probe is admitted. Default 5000 — deliberately BELOW aiQueue's
# 10s exponential backoff base. A cooldown spanning the retry window makes all 3 BullMQ attempts
# fast-fail without probing, so the job exhausts and dead-letters: a 30s blip would DLQ every
# in-flight reply.
# OPENAI_BREAKER_COOLDOWN_MS=5000
# Concurrent probes admitted while half-open. Default 1.
# OPENAI_BREAKER_HALF_OPEN_PROBES=1

# --- Product image matching (customer photo → catalog) ---
# Minimum cosine similarity for visual fingerprint retrieval (0–1). Default: 0.62
# IMAGE_SIMILARITY_THRESHOLD=0.62
# Minimum composite confidence before claiming an exact product match. Default: 0.55
# IMAGE_MATCH_CONFIDENCE_THRESHOLD=0.55
# Below this vision extraction confidence, ask the customer to clarify. Default: 0.35
# VISION_EXTRACTION_CONFIDENCE_MIN=0.35
# When top-2 visual matches are within this delta, run vision re-ranking. Default: 0.04
# IMAGE_MATCH_AMBIGUITY_DELTA=0.04
# Image fingerprint reconciliation (missing catalog image embeddings).
# IMAGE_FINGERPRINT_RECONCILE_CRON=30 */6 * * *
# IMAGE_FINGERPRINT_RECONCILE_BATCH_LIMIT=100

# =============================================================================
# P2 ENABLEMENT BLOCK (paste-ready)
# =============================================================================
# The entire Phase-P2 remediation ships default-OFF: a deploy that omits every key below runs
# byte-for-byte legacy behavior. To enable P2 in an environment, uncomment this block as a unit.
# It is the audited, self-consistent combination (degradation floor ON before/with the caps;
# breaker in monitor for its bake-in window; 2 x OPENAI_TURN_DEADLINE_MS < the 300s conversation
# lock TTL; breaker cooldown < the aiQueue 10s retry backoff base). Flip in staging first; watch
# the boot posture lines from validateEnv for the flag-combination warnings.
#
# P2-1 — deterministic grounding gate + facts_used contract (RC-01/02/03)
# FACTS_USED_CONTRACT=true
# GROUNDING_GATE_CONSOLIDATED=true
#
# P2-2 — order-stage FSM + structured intent + sticky locale + stored-timestamp commission
# (run ORDER_STAGE_MACHINE=shadow for a parity window before =on)
# ORDER_STAGE_MACHINE=on
# INTENT_STRUCTURED_CONTRACT=true
# STICKY_LOCALE_SLOT=true
# COMMISSION_STORED_TIMESTAMP=true
#
# P2-3 — delivery-filtered transcript + slot-backed summary + versioned config cache
# HISTORY_DELIVERY_FILTERED=true
# SUMMARY_SLOT_BACKED=true
# AI_CONFIG_VERSIONED_CACHE=true
#
# P2-4 — decision ledger + receipt snapshot + webhook dedupe + structured logging
# AI_DECISION_LEDGER_ENABLED=true
# RECEIPT_TIME_SNAPSHOT=true
# WEBHOOK_DEDUPE_REPLAY=true
# STRUCTURED_LOGGING=true
#
# P2-5 — Albanian/Gheg + prompt hygiene (GHEG_LEXICONS should accompany ORDER_STAGE_MACHINE=on,
# or Gheg consent forms are silently missed)
# GHEG_LEXICONS=true
# DIALECT_NORMALIZATION=true
# RESTRICTIONS_FOOTER_ALL_TENANTS=true
# PROMPT_ALLOWLIST_BUDGET=true
#
# P2-6 — resilience (GRACEFUL_DEGRADE_MODE first; caps second; breaker monitor -> on only after
# the monitor window shows no false would-open events)
# GRACEFUL_DEGRADE_MODE=true
# OPENAI_CALL_TIMEOUT_MS=45000
# OPENAI_TURN_DEADLINE_MS=120000
# OPENAI_CIRCUIT_BREAKER=monitor
#
# P2-7 — fleet drift registry (boot fingerprint is always on; this adds the DB registry)
# CONFIG_FINGERPRINT_REGISTRY=true
