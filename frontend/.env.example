# Browser-visible API base (include /api path).
VITE_API_URL=http://localhost:8000/api

# WebSocket origin for realtime (no path).
VITE_WS_URL=ws://localhost:8000

# Meta JS SDK (WhatsApp Embedded Signup). Injected into index.html at build time.
VITE_META_APP_ID=
# Embedded Signup configuration id (Meta Developer App > WhatsApp > Embedded signup).
VITE_WHATSAPP_CONFIGURATION_ID=
# Optional: force OAuth redirect_uri sent to the API (must match backend WHATSAPP_EMBEDDED_SIGNUP_REDIRECT_URI and Meta Valid OAuth redirect URIs exactly). If unset, the current page URL is used when signup starts.
# VITE_WHATSAPP_EMBEDDED_SIGNUP_REDIRECT_URI=https://your-app.vercel.app/channels

# Production examples:
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_WS_URL=wss://api.yourdomain.com
